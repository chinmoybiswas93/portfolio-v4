includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
    excludePaths:
        # Vendor-published configs that reference optional packages we do not install
        - config/media-library.php
        - config/settings.php
    level: 6
    checkModelProperties: true
    # Read the casts() methods so enum, date and array casts are typed correctly
    parseModelCastsMethod: true
