{
  "ci": {
    "collect": {
      "startServerCommand": "php artisan serve --host=127.0.0.1 --port=8090",
      "startServerReadyPattern": "Server running",
      "url": [
        "http://127.0.0.1:8090/",
        "http://127.0.0.1:8090/projects/sample-shop",
        "http://127.0.0.1:8090/blog",
        "http://127.0.0.1:8090/blog/speeding-up-wordpress"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.01
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 150
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 358400
          }
        ],
        "resource-summary:font:count": [
          "error",
          {
            "maxNumericValue": 2
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
